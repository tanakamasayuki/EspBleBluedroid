# pytest-embedded derives these names from the Arduino CLI profile names and
# the peer directory name. host/device are fixture names, not BLE roles.
TEST_SERIAL_PORT_ESP32_PEER_HOST=/dev/ttyUSB0
TEST_SERIAL_PORT_PEER_DEVICE_ESP32_PEER_DEVICE=/dev/ttyUSB1

# EspBle cross-stack suite (tests/interop). EspBle does not run on the original
# ESP32, so its half runs on an ESP32-S3 — the parent fixture of that suite, with
# the same second ESP32 as its peer. The EspBle version is pinned in each interop
# sketch.yaml, so nothing needs downloading by hand.
TEST_SERIAL_PORT_S3_PEER_HOST=/dev/ttyACM0

# Optional HTML report:
# PYTEST_ADDOPTS="--html=report.html --self-contained-html"

